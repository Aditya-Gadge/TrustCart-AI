# TrustCart AI environment template — copy to `.env` and fill in local values.
# Never commit real credentials to this repository. Every value below is a
# PLACEHOLDER — if real credentials ever appear here, rotate them immediately
# and remove them from the file.

# PostgreSQL connection string for local development.
# Start the throwaway local database with: docker compose up -d
# (same local-only credentials as docker-compose.yml, host port 54329).
DATABASE_URL="postgresql://trustcart:trustcart_local_dev_only@localhost:54329/trustcart"

# Gemini API key for the merchant copilot (Phase 4). Server-side ONLY — never
# exposed to the browser. Get a free key at https://aistudio.google.com/.
# Without it the app still boots; the copilot page degrades to live stored data.
GEMINI_API_KEY="PASTE-YOUR-GEMINI-API-KEY-HERE"

# Optional override of the Gemini model identifier. Verify that the selected
# model is currently available to your Google AI Studio project.
# GEMINI_MODEL=""

# PayPal SANDBOX credentials for the payment flow (Phase 5). Server-side ONLY
# — the secret never reaches the browser. Create a Sandbox app at
# https://developer.paypal.com/dashboard/applications. Only the Sandbox host
# is supported; live credentials are refused by validation.
PAYPAL_CLIENT_ID="PASTE-YOUR-PAYPAL-SANDBOX-CLIENT-ID-HERE"
PAYPAL_CLIENT_SECRET="PASTE-YOUR-PAYPAL-SANDBOX-CLIENT-SECRET-HERE"
# Optional; validation refuses any host other than the Sandbox API.
# PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# Optional: webhook signature verification (Phase 5). Create a webhook in the
# PayPal developer dashboard and paste its generated ID here. Without it the
# webhook route returns 503 webhook_unconfigured.
# PAYPAL_WEBHOOK_ID=""
